{
  "name": "anki-audio-deck-creator",
  "version": "1.0.0",
  "description": "Criador de Cards de Estudo para Anki com Áudio e Atalhos Rápidos",
  "author": "Jhonny",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4600",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "compile:all": "yarn compile:electron && yarn build",
    "electron:dev": "node scripts/dev.js",
    "pack:light": "electron-builder --config electron-builder.json --publish never",
    "build:electron": "yarn compile:all && yarn pack:light"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@types/node": "^22.10.7",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "wait-on": "^8.0.2"
  }
}
